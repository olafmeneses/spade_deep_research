# Copy to .env and fill in w/ your values

# API Keys
OPENAI_API_KEY=your-openai-api-key
TAVILY_API_KEY=your-tavily-api-key

# OpenAI-compatible endpoint (i.e. Azure OpenAI Base URL)
# OPENAI_BASE_URL=https://api.openai.com/v1

# XMPP
JID_DOMAIN=127.0.0.1
PASSWORD=password

# Storage
ARXIV_STORAGE_PATH=./data/arxiv_papers
# CHROMADB_PATH=./data/chromadb
# CHROMADB_COLLECTION=documents

# MCP server
ARXIV_MCP_URL=http://localhost:8000/mcp
# Docker Compose uses this image for the MCP service. Build or pull it before
# running compose if you do not publish it under this tag.
ARXIV_MCP_IMAGE=arxiv-mcp-server:latest

# Timeouts (seconds)
PLANNER_TIMEOUT=120
RESEARCH_TIMEOUT=600
WRITER_TIMEOUT=600
CRITIC_TIMEOUT=180
SUBAGENT_RESPONSE_TIMEOUT=180
# Optional subagent execution controls. Leave SUBAGENT_SOFT_TIMEOUT unset to disable it.
# SUBAGENT_SOFT_TIMEOUT=120
# SUBAGENT_HARD_TIMEOUT=180
# Optional coordinator execution controls. Soft timeout stops launching/waiting for more research and forces synthesis.
# COORDINATOR_SOFT_TIMEOUT=240
# COORDINATOR_HARD_TIMEOUT=600

# Agent pool
AGENTS_PER_TYPE=1
MAX_PARALLEL=3
# Optional budget caps
# MAX_COORDINATOR_DELEGATIONS=12
# MAX_TAVILY_CALLS_PER_SESSION=8
# MAX_TAVILY_CALLS_PER_AGENT=3
# COORDINATOR_RETURN_RAW_FINDINGS=false
# Number of critic-requested loop-backs; 0 skips critic review.
# MAX_CRITIC_ITERATIONS=2
# Maximum output token hint used by compatible LLM providers.
# MAX_OUTPUT_TOKENS=4096

# LLM models
# Default model used by all agents unless overridden below
LLM_DEFAULT=openai/gpt-5-nano
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Per-agent overrides (optional, falls back to LLM_DEFAULT)
# LLM_PLANNER=openai/gpt-5-nano
# LLM_WRITER=openai/gpt-5-nano
# LLM_CRITIC=openai/gpt-5-nano
# LLM_COORDINATOR=openai/gpt-5-nano
# LLM_ARXIV=openai/gpt-5-nano
# LLM_TAVILY=openai/gpt-5-nano
# LLM_KNOWLEDGE_BASE=openai/gpt-5-nano
# Tavily cache
# ENABLE_TAVILY_CACHE=true
# TAVILY_CACHE_PATH=./data/tavily_cache.sqlite
# TAVILY_CACHE_TTL_DAYS=21

# Direct-runner baseline controls
# DIRECT_TOOLS_MAX_TAVILY_CALLS=8

# Benchmark and judging controls
# BENCHMARK_LLM_BACKEND=openai
# BENCHMARK_OPENAI_API_KEY=
# BENCHMARK_OPENAI_BASE_URL=
# BENCHMARK_JUDGE_MODEL=gpt-5
# BENCHMARK_JUDGE_REQUEST_PROFILE=compat_openai
# BENCHMARK_CLEAN_MODEL=
# BENCHMARK_CLEAN_BASE_URL=
# BENCHMARK_CLEAN_API_KEY=
# BENCHMARK_CLEAN_REQUEST_PROFILE=
# BENCHMARK_CLEAN_BACKEND=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://github.com/olafmeneses/spade_deep_research
# OPENROUTER_TITLE=SPADE Deep Research

# Observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_OTEL_HOST=http://localhost:3000
# LITELLM_CALLBACKS=langfuse_otel
